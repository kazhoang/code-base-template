{
  "name": "code_base_template",
  "version": "1.0.0",
  "private": true,
  "description": "React Native starter template on the New Architecture (Fabric + TurboModules)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "test:report": "jest --coverage --coverageDirectory=\"./coverage\" --ci",
    "pod": "cd ios && bundle exec pod install && cd ..",
    "clean": "rm -rf node_modules ios/Pods ios/Podfile.lock && yarn install && yarn pod"
  },
