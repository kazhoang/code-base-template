    "@tanstack/react-query": "^5.104.2",
    "easy-peasy": "^6.1.1",
    "i18next": "^26.4.4",
    "ky": "^2.2.0",
    "lottie-react-native": "^7.5.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.87.1",
    "react-native-avoid-softinput": "^9.0.1",
